{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "${RICE_API_BASE}/api/:path*" },
    { "source": "/data/:path*", "destination": "${RICE_API_BASE}/data/:path*" },
    { "source": "/((?!api/|data/).*)", "destination": "/index.html" }
  ]
}
